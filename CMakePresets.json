{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows x64 (MSVC toolset)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": { "value": "x64", "strategy": "set" }
        },
        {
            "name": "windows-clang-cl",
            "displayName": "Windows x64 (clang-cl toolset, matches the vcxproj)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": { "value": "x64", "strategy": "set" },
            "toolset": { "value": "ClangCL", "strategy": "set" }
        },
        {
            "name": "windows-shipping",
            "displayName": "Windows x64 shipping (harness + profiling compiled out, exceptions off)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": { "value": "x64", "strategy": "set" },
            "toolset": { "value": "ClangCL", "strategy": "set" },
            "cacheVariables": {
                "TS_SAFETY_CHECKS": "OFF",
                "TS_PROFILING": "OFF",
                "MACRAME_NO_EXCEPTIONS": "ON"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux (clang, plain stress driver)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "TS_TSAN": "OFF"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux (GCC)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "TS_TSAN": "OFF"
            }
        },
        {
            "name": "linux-tsan",
            "displayName": "Linux (clang + ThreadSanitizer stress driver)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "TS_TSAN": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
        { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
        { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl", "configuration": "Release" },
        { "name": "windows-shipping", "configurePreset": "windows-shipping", "configuration": "Release" },
        { "name": "linux-clang", "configurePreset": "linux-clang" },
        { "name": "linux-gcc", "configurePreset": "linux-gcc" },
        { "name": "linux-tsan", "configurePreset": "linux-tsan" }
    ]
}
